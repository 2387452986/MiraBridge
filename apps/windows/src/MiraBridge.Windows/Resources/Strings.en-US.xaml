  <sys:String x:Key="TechnicalDetails">View technical details</sys:String>
  <sys:String x:Key="ConnectTitle">Connect a Mac</sys:String>
  <sys:String x:Key="ConnectDescription">Pairing takes two copy-and-paste steps. Your private key never leaves the Mac.</sys:String>
  <sys:String x:Key="PairStep1">1</sys:String>
  <sys:String x:Key="PairStep1Title">Create a request on your Mac</sys:String>
  <sys:String x:Key="PairStep1Description">Ask Codex to run mirabridge pair create, then copy the request code.</sys:String>
  <sys:String x:Key="PairStep2">2</sys:String>
  <sys:String x:Key="PairStep2Title">Paste the request and authorize</sys:String>
  <sys:String x:Key="PairStep2Description">MiraBridge adds only this Mac's public key and preserves existing SSH keys.</sys:String>
  <sys:String x:Key="PairRequest">Mac pairing request</sys:String>
  <sys:String x:Key="Paste">Paste from clipboard</sys:String>
  <sys:String x:Key="Pair">Authorize this Mac</sys:String>
  <sys:String x:Key="PairStep3">3</sys:String>
  <sys:String x:Key="PairStep3Title">Return the response to your Mac</sys:String>
  <sys:String x:Key="PairStep3Description">Copy the response and ask Codex to run mirabridge pair accept &lt;response&gt; to verify this PC's fingerprint.</sys:String>
  <sys:String x:Key="PairResponse">Windows pairing response</sys:String>
  <sys:String x:Key="CopyResponse">Copy response</sys:String>

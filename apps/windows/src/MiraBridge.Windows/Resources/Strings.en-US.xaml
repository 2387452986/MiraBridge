  <sys:String x:Key="FilesCapabilityTitle">Work with files and projects</sys:String>
  <sys:String x:Key="FilesCapabilityDescription">Browse Desktop and projects, precisely edit code, and transfer complete directories between Mac and Windows.</sys:String>
  <sys:String x:Key="ProcessCapabilityTitle">Run commands and long jobs</sys:String>
  <sys:String x:Key="ProcessCapabilityDescription">Build, test, package, and render. Long jobs keep running through disconnects and can be recovered.</sys:String>
  <sys:String x:Key="WebCapabilityTitle">Verify real web pages</sys:String>
  <sys:String x:Key="WebCapabilityDescription">Start a local site and use Edge to inspect desktop/mobile screenshots, content, and console errors.</sys:String>
  <sys:String x:Key="MaintenanceCapabilityTitle">Handle everyday maintenance</sys:String>
  <sys:String x:Key="MaintenanceCapabilityDescription">Inspect Desktop and system state, scan disks and Recycle Bin; destructive actions still require confirmation.</sys:String>

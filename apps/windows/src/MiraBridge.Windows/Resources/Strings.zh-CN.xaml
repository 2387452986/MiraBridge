<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:String x:Key="AppTitle">MiraBridge for Windows</sys:String>
  <sys:String x:Key="Subtitle">Agent 在 macOS 推理 · Windows 执行原生工具</sys:String>
  <sys:String x:Key="VersionLine">版本 2.0.0-rc.1 · RPC 2.0 · 28 个工具</sys:String>
  <sys:String x:Key="SetupStep1Title">1. 安装并修复核心服务</sys:String>
  <sys:String x:Key="SetupStep1Description">MiraBridge 已内置 Node、Worker、浏览器支持和 ConPTY。独立提权助手只用一次 UAC 修复 OpenSSH、LocalSubnet 防火墙规则和 ACL。</sys:String>
  <sys:String x:Key="SetupStep2Title">2. 配对此 Windows 电脑</sys:String>
  <sys:String x:Key="CopyResponse">复制响应码</sys:String>
  <sys:String x:Key="StatusTab">状态</sys:String>
  <sys:String x:Key="SetupTab">首次设置</sys:String>
  <sys:String x:Key="ConfigTab">配置</sys:String>
  <sys:String x:Key="MaintenanceTab">维护</sys:String>
  <sys:String x:Key="Refresh">刷新状态</sys:String>
  <sys:String x:Key="Repair">安装 / 一键修复</sys:String>
  <sys:String x:Key="PairRequest">粘贴 Mac 配对请求码</sys:String>
  <sys:String x:Key="Pair">授权并生成响应码</sys:String>
  <sys:String x:Key="PairResponse">复制此响应码回 Mac</sys:String>
  <sys:String x:Key="DefaultRoot">默认允许目录</sys:String>
  <sys:String x:Key="AddRoot">添加目录</sys:String>
  <sys:String x:Key="RemoveRoot">移除精确目录</sys:String>
  <sys:String x:Key="AllowedRoots">允许目录</sys:String>
  <sys:String x:Key="AllowedRootsDescription">每次文件操作都由 Worker 执行边界校验。不建议把整个 C:\ 或 C:\Users 加入允许范围。</sys:String>
  <sys:String x:Key="Capabilities">能力</sys:String>
  <sys:String x:Key="CapabilityDescription">外网网页导航保持关闭；清空回收站仍需要新鲜扫描凭证和 Mac 侧审批。</sys:String>
  <sys:String x:Key="Desktop">桌面访问</sys:String>
  <sys:String x:Key="Recycle">回收站</sys:String>
  <sys:String x:Key="WebSnapshot">本地网页快照</sys:String>
  <sys:String x:Key="ApplyCapabilities">保存能力设置</sys:String>
  <sys:String x:Key="PairedMacs">已配对的 Mac</sys:String>
  <sys:String x:Key="RevokeFingerprint">要撤销的公钥指纹</sys:String>
  <sys:String x:Key="RevokePairing">撤销访问</sys:String>
  <sys:String x:Key="CheckUpdate">检查更新</sys:String>
  <sys:String x:Key="UpdateSupport">更新与支持</sys:String>
  <sys:String x:Key="OptionalTools">可选工具</sys:String>
  <sys:String x:Key="OptionalToolsDescription">只在真实 Windows 任务需要时安装。MiraBridge 永远不会安装或升级显卡驱动。</sys:String>
  <sys:String x:Key="Diagnostics">生成脱敏诊断</sys:String>
  <sys:String x:Key="ReportIssue">打开 GitHub Issue</sys:String>
  <sys:String x:Key="Help">打开本地帮助</sys:String>
  <sys:String x:Key="UninstallTitle">卸载</sys:String>
  <sys:String x:Key="UninstallDescription">两种方式都只移除 MiraBridge 自己管理的 SSH 密钥、配置块、防火墙规则和开机启动项；你可以选择是否保留 Worker 配置、Job 历史、日志和审计数据。</sys:String>
  <sys:String x:Key="UninstallPreserve">卸载并保留数据</sys:String>
  <sys:String x:Key="UninstallAll">完全卸载</sys:String>
  <sys:String x:Key="UnsignedWarning">此 RC 未代码签名，Windows SmartScreen 可能提示“未知发布者”。请只从官方 GitHub Release 下载并核对 SHA-256。</sys:String>
</ResourceDictionary>

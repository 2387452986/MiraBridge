<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:String x:Key="AppTitle">MiraBridge for Windows</sys:String>
  <sys:String x:Key="Subtitle">让 Mac 上的 Codex 使用这台 Windows</sys:String>
  <sys:String x:Key="VersionLine">2.0.0-rc.4 · RPC 2.0 · 28 个工具</sys:String>
  <sys:String x:Key="NavOverview">总览</sys:String>
  <sys:String x:Key="NavConnect">连接 Mac</sys:String>
  <sys:String x:Key="NavAccess">权限与目录</sys:String>
  <sys:String x:Key="NavTools">工具与维护</sys:String>
  <sys:String x:Key="NavFooter">Agent 在 Mac 推理&#10;Windows 只执行工具</sys:String>
  <sys:String x:Key="OverviewEyebrow">这台电脑的 MiraBridge</sys:String>
  <sys:String x:Key="ReadyTitle">已就绪，可以开始工作</sys:String>
  <sys:String x:Key="ReadyDescription">Mac 上的 Codex 已可把这台 Windows 当作原生工具环境使用。</sys:String>
  <sys:String x:Key="AttentionTitle">还差一步即可使用</sys:String>
  <sys:String x:Key="AttentionDescription">核心服务尚未全部就绪。先运行一键修复，再连接你的 Mac。</sys:String>
  <sys:String x:Key="Refresh">刷新</sys:String>
  <sys:String x:Key="Repair">一键检查与修复</sys:String>
  <sys:String x:Key="CurrentConnection">核心服务</sys:String>
  <sys:String x:Key="SshService">安全连接</sys:String>
  <sys:String x:Key="WorkerService">Windows 执行器</sys:String>
  <sys:String x:Key="EdgeService">Edge 网页验收</sys:String>
  <sys:String x:Key="TerminalService">交互终端</sys:String>
  <sys:String x:Key="ServiceReady">可用</sys:String>
  <sys:String x:Key="ServiceAttention">需处理</sys:String>
  <sys:String x:Key="ConnectionInfo">连接信息</sys:String>
  <sys:String x:Key="Addresses">局域网地址</sys:String>
  <sys:String x:Key="HostFingerprint">主机指纹</sys:String>
  <sys:String x:Key="Architecture">系统架构</sys:String>
  <sys:String x:Key="ActiveJobs">正在执行的任务</sys:String>
  <sys:String x:Key="Storage">MiraBridge 存储</sys:String>
  <sys:String x:Key="Copy">复制</sys:String>
  <sys:String x:Key="CapabilityOverview">Codex 可以在这台 Windows 上做什么</sys:String>
  <sys:String x:Key="FilesCapabilityTitle">处理文件和项目</sys:String>
  <sys:String x:Key="FilesCapabilityDescription">浏览桌面和项目，精确修改代码，在 Mac 与 Windows 之间传输完整目录。</sys:String>
  <sys:String x:Key="ProcessCapabilityTitle">运行命令和长任务</sys:String>
  <sys:String x:Key="ProcessCapabilityDescription">构建、测试、打包和渲染；长任务断线后仍继续，并可重新找回。</sys:String>
  <sys:String x:Key="WebCapabilityTitle">真实检查网页</sys:String>
  <sys:String x:Key="WebCapabilityDescription">启动本地网站，用 Edge 检查桌面/移动截图、正文和控制台错误。</sys:String>
  <sys:String x:Key="MaintenanceCapabilityTitle">完成日常维护</sys:String>
  <sys:String x:Key="MaintenanceCapabilityDescription">查看桌面和系统状态，扫描回收站与磁盘；危险操作仍需明确确认。</sys:String>
  <sys:String x:Key="FirstUseTitle">第一次使用？</sys:String>
  <sys:String x:Key="FirstUseDescription">连接 Mac 后，后续任务只需在 Codex 中说明要使用 Windows。</sys:String>
  <sys:String x:Key="GoPairing">连接我的 Mac</sys:String>
  <sys:String x:Key="TechnicalDetails">查看技术详情</sys:String>
  <sys:String x:Key="ConnectTitle">连接一台 Mac</sys:String>
  <sys:String x:Key="ConnectDescription">配对只需要往返复制两段代码。私钥不会离开 Mac。</sys:String>
  <sys:String x:Key="PairStep1">1</sys:String>
  <sys:String x:Key="PairStep1Title">在 Mac 上生成请求码</sys:String>
  <sys:String x:Key="PairStep1Description">让 Codex 运行 mirabridge pair create，然后复制输出的请求码。</sys:String>
  <sys:String x:Key="PairStep2">2</sys:String>
  <sys:String x:Key="PairStep2Title">粘贴请求并授权</sys:String>
  <sys:String x:Key="PairStep2Description">MiraBridge 只会添加这个 Mac 的公钥，并保留已有 SSH 密钥。</sys:String>
  <sys:String x:Key="PairRequest">Mac 配对请求码</sys:String>
  <sys:String x:Key="Paste">从剪贴板粘贴</sys:String>
  <sys:String x:Key="Pair">授权这台 Mac</sys:String>
  <sys:String x:Key="PairStep3">3</sys:String>
  <sys:String x:Key="PairStep3Title">把响应码带回 Mac</sys:String>
  <sys:String x:Key="PairStep3Description">复制响应码，让 Codex 运行 mirabridge pair accept &lt;响应码&gt; 完成主机指纹验证。</sys:String>
  <sys:String x:Key="PairResponse">Windows 配对响应码</sys:String>
  <sys:String x:Key="CopyResponse">复制响应码</sys:String>
  <sys:String x:Key="PairedMacs">已连接的 Mac</sys:String>
  <sys:String x:Key="NoPairedMacs">还没有 Mac 连接到这台电脑。</sys:String>
  <sys:String x:Key="SelectToRevoke">选择一台 Mac 后可撤销它的访问权限。</sys:String>
  <sys:String x:Key="RevokePairing">撤销所选 Mac</sys:String>
  <sys:String x:Key="PairingSecurity">配对码不是密码。Mac 仍会通过实时 SSH 指纹核对确认它连接的是这台电脑。</sys:String>
  <sys:String x:Key="AccessTitle">控制 Codex 可以访问什么</sys:String>
  <sys:String x:Key="AccessDescription">目录和高风险能力由 Worker 在代码层强制执行，不依赖提示词。</sys:String>
  <sys:String x:Key="AllowedRoots">允许访问的目录</sys:String>
  <sys:String x:Key="AllowedRootsDescription">Codex 只能在这些目录内打开工作区。不要为了省事开放整个 C:\ 或 C:\Users。</sys:String>
  <sys:String x:Key="NoAllowedRoots">当前没有允许目录，请先添加一个工作目录。</sys:String>
  <sys:String x:Key="RootInput">输入要添加或移除的完整 Windows 路径</sys:String>
  <sys:String x:Key="AddRoot">添加目录</sys:String>
  <sys:String x:Key="RemoveRoot">移除这个目录</sys:String>
  <sys:String x:Key="CapabilitySettings">额外能力</sys:String>
  <sys:String x:Key="Desktop">桌面访问</sys:String>
  <sys:String x:Key="DesktopDescription">是否允许 Codex 查看或修改当前 Windows 用户的桌面文件。</sys:String>
  <sys:String x:Key="Disabled">关闭</sys:String>
  <sys:String x:Key="ReadOnly">只读</sys:String>
  <sys:String x:Key="ReadWrite">读写</sys:String>
  <sys:String x:Key="Recycle">允许扫描回收站</sys:String>
  <sys:String x:Key="RecycleDescription">真正清空前仍需要即时扫描结果和 Mac 侧审批。</sys:String>
  <sys:String x:Key="WebSnapshot">允许本地网页验收</sys:String>
  <sys:String x:Key="WebSnapshotDescription">只访问 loopback 和本地网页，不使用你的浏览器登录状态。</sys:String>
  <sys:String x:Key="ApplyCapabilities">保存能力设置</sys:String>
  <sys:String x:Key="SafetyBoundary">这些设置只控制 MiraBridge 的工具边界，不会修改 Windows 用户权限或关闭安全软件。</sys:String>
  <sys:String x:Key="ToolsTitle">工具与维护</sys:String>
  <sys:String x:Key="ToolsDescription">核心运行时已经内置；开发与媒体工具只在实际任务需要时安装。</sys:String>
  <sys:String x:Key="CoreRuntime">核心运行时</sys:String>
  <sys:String x:Key="CoreRuntimeDescription">Node、Worker、Edge 支持和交互终端随 MiraBridge 安装，无需单独配置。</sys:String>
  <sys:String x:Key="OptionalTools">可选生产力工具</sys:String>
  <sys:String x:Key="OptionalToolsDescription">点击后由 WinGet 安装或修复。MiraBridge 不会安装或升级显卡驱动。</sys:String>
  <sys:String x:Key="InstallOrRepair">安装 / 修复</sys:String>
  <sys:String x:Key="GitDescription">代码仓库、分支和版本管理</sys:String>
  <sys:String x:Key="PowerShellDescription">现代 Windows 自动化 Shell</sys:String>
  <sys:String x:Key="PythonDescription">脚本、数据处理和自动化</sys:String>
  <sys:String x:Key="NodeDescription">Windows 本地前端与 Node 项目</sys:String>
  <sys:String x:Key="DotNetDescription">构建和测试 .NET 项目</sys:String>
  <sys:String x:Key="FfmpegDescription">音视频分析、转码与渲染</sys:String>
  <sys:String x:Key="UpdateSupport">更新与支持</sys:String>
  <sys:String x:Key="CheckUpdate">检查更新</sys:String>
  <sys:String x:Key="Diagnostics">生成脱敏诊断</sys:String>
  <sys:String x:Key="ReportIssue">报告问题</sys:String>
  <sys:String x:Key="Help">使用帮助</sys:String>
  <sys:String x:Key="UnsignedWarning">当前 RC 未代码签名，SmartScreen 可能显示未知发布者。只从官方 GitHub Release 下载并核对 SHA-256。</sys:String>
  <sys:String x:Key="AdvancedUninstall">高级选项与卸载</sys:String>
  <sys:String x:Key="UninstallDescription">卸载只移除 MiraBridge 管理的内容；你可以选择保留或清除 Worker 配置、Job、日志和审计。</sys:String>
  <sys:String x:Key="UninstallPreserve">卸载并保留数据</sys:String>
  <sys:String x:Key="UninstallAll">完全卸载</sys:String>
  <sys:String x:Key="Working">正在处理，请稍候…</sys:String>
  <sys:String x:Key="MinimizeWindow">最小化</sys:String>
  <sys:String x:Key="MaximizeWindow">最大化或还原</sys:String>
  <sys:String x:Key="CloseToTray">关闭到系统托盘</sys:String>
</ResourceDictionary>

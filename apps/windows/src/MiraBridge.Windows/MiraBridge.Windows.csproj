<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MiraBridge.Windows</AssemblyName>
    <RootNamespace>MiraBridge.Windows</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>Assets\mirabridge.ico</ApplicationIcon>
    <StartupObject>MiraBridge.Windows.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MiraBridge.Windows.Core\MiraBridge.Windows.Core.csproj" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Help\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\mirabridge.ico" />
    <Resource Include="Assets\mirabridge.png" />
  </ItemGroup>
</Project>
